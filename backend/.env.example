r# Copy to .env (or set these as real environment variables / secrets in
# your deployment platform). Never commit actual secrets.

# --- Database (Neon/PostgreSQL) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/velocira
DATABASE_USERNAME=velocira
DATABASE_PASSWORD=

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Payments (Razorpay) ---
PAYMENT_KEY_ID=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Storage (Cloudinary) ---
CLOUDINARY_URL=

# --- Email (SMTP — e.g. Resend, SendGrid) ---
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=587
EMAIL_API_KEY=

# --- SMS ---
SMS_API_KEY=

# --- Maps ---
MAP_API_KEY=

# --- AI (car recommendations) ---
AI_API_KEY=

# --- Runtime ---
PORT=8080
